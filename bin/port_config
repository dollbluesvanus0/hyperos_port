# 需要移植的分区
partition_to_port=system product system_ext mi_ext


# 可能的super子分区列表
super_list=vendor mi_ext odm system product system_ext

# 打包为 ext4 文件系统（如果底包是erofs） true:是  false:否    意义：解锁system
# Packing/Repacking target ROM filesystem with EXT4 or not. wiht EXT4, you can mount system parititon in read-write mode, which is not possible for EROFS filesystem. 
repack_with_ext4=true

# 去除data加密   true:是  false:否
# Remove data encryption or not. if it is false, you cannot access encrypted-data partition in recovery without a A14 supported TWRP.
# РЕКОМЕНДУЕТСЯ true: иначе после Format Data в TWRP /data может не смонтироваться
# (Invalid argument) из-за метаданных шифрования, несовместимых со старым vendor.
remove_data_encryption=true

# Packing Rom with Payload.bin/new.dat.br type or super.img
pack_method=aosp

# Принудительно включить ADB и root-отладку в порте (для отладки бутлупов).
# ВНИМАНИЕ: ro.adb.secure=0 отключает запрос авторизации ПК - только для отладки!
# Force enable ADB and root debugging in the ported ROM (handy to debug bootloops).
# WARNING: ro.adb.secure=0 disables the PC authorization prompt - debugging only!
force_enable_adb=true

# SELinux permissive в boot-образах сборки (androidboot.selinux=permissive).
# Для отладки портов со старым vendor: система перестаёт падать от avc-denials,
# adb/logcat доступны для диагностики. ВНИМАНИЕ: ослабляет безопасность!
# Force SELinux permissive in the packaged boot images (debug aid): old-vendor
# avc denials stop killing services. WARNING: weakens security!
selinux_permissive=false

# Патчить framework.jar / miui-services.jar / services.jar (обход проверки
# подписи APK, Kaorios Toolbox). ВНИМАНИЕ: пересборка jar сторонними тулами
# может давать битый dex -> вечная загрузка на анимации. По умолчанию ВЫКЛ.
# Patch framework/miui-services/services jars (APK signature bypass +
# Kaorios Toolbox). WARNING: third-party jar rebuilds can produce broken dex
# -> endless boot animation. Disabled by default.
patch_framework_jars=false